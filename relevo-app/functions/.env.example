# Parámetros de las Cloud Functions de Relevo.
# Copia este archivo a `functions/.env` para el emulador y para el despliegue
# (firebase deploy lee functions/.env). Los valores de abajo son los predeterminados.

# URL pública de la app; se usa en los enlaces de los correos.
APP_URL=https://relevo-e5eaf.web.app

# Zona horaria de las personas cuidadas (los horarios "HH:mm" de los medicamentos se interpretan aquí).
ZONA_HORARIA=America/Mexico_City

# Correo desde el que se envían los avisos a quien usa la web. VACÍO = no se envían correos
# (los push al teléfono siguen funcionando). Cuando exista la cuenta de la app, ponla aquí y define
# la contraseña como secreto:  firebase functions:secrets:set CORREO_CONTRASENA
CORREO_USUARIO=
CORREO_SMTP_HOST=smtp.gmail.com
CORREO_SMTP_PUERTO=465

# true para avisar también cuando una toma se marca como realizada (por defecto solo omitidas y pendientes).
NOTIFICAR_TOMAS_REALIZADAS=false

# Minutos antes de cada toma de medicamento en que se avisa al cuidador (las tareas de la rutina traen el suyo).
AVISO_MEDICAMENTOS_MIN=15

# Modelo de Gemini que usa el asistente (Cloud Function preguntarAsistente). La clave va en el secreto GEMINI_API_KEY.
MODELO_IA=gemini-3.6-flash

# Cómo se llama a Gemini: vertex (Vertex AI, se factura al proyecto de Google Cloud, sin clave) o gemini (clave de AI Studio en el secreto GEMINI_API_KEY).
IA_BACKEND=vertex
VERTEX_UBICACION=us-central1
