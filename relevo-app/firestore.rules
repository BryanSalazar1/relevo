rules_version = '2';

// Reglas de seguridad de Relevo.
// Todo el acceso se resuelve POR PERSONA CUIDADA usando la subcolección `miembros`
// (sección 8 de la documentación). Un usuario solo ve/edita a las personas
// en las que es miembro, y lo que puede hacer depende de su rol.
//
// Tipos de cuenta (usuarios/{uid}.tipo): familiar | enfermero | medico.
//   - Solo un FAMILIAR da de alta personas cuidadas y queda como responsable (cuidador_principal).
//   - Al unirse por invitación cada cuenta recibe el rol que le corresponde:
//     familiar -> familiar, enfermero -> cuidador_turno, medico -> medico.
//   - Un familiar puede ser ascendido a responsable por otro responsable.
//
// Invitaciones (compartir por código/QR): el responsable crea `invitaciones/{codigo}`; quien
// conoce el código se agrega a sí mismo como miembro en un batch que estas reglas validan
// de punta a punta (sin Cloud Functions).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function autenticado() {
      return request.auth != null;
    }

    function esMiembro(personaId) {
      return autenticado()
        && exists(/databases/$(database)/documents/personas_cuidadas/$(personaId)/miembros/$(request.auth.uid));
    }

    function rol(personaId) {
      return get(/databases/$(database)/documents/personas_cuidadas/$(personaId)/miembros/$(request.auth.uid)).data.rol;
    }

    function tieneRol(personaId, roles) {
      return esMiembro(personaId) && rol(personaId) in roles;
    }

    function tipoUsuario(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.tipo;
    }

    // Rol que recibe cada tipo de cuenta al unirse por invitación
    function rolPorTipo(tipo) {
      return tipo == 'familiar' ? 'familiar' : (tipo == 'enfermero' ? 'cuidador_turno' : 'medico');
    }

    // Roles que puede tener cada tipo de cuenta
    function rolCompatible(tipo, rolNuevo) {
      return (tipo == 'familiar' && rolNuevo in ['familiar', 'cuidador_principal'])
        || (tipo == 'enfermero' && rolNuevo == 'cuidador_turno')
        || (tipo == 'medico' && rolNuevo == 'medico');
    }

    // Estado de la persona DESPUÉS del batch actual (creación atómica persona + miembro, o canje)
    function estaraEnMiembrosUids(personaId) {
      return autenticado()
        && request.auth.uid in getAfter(/databases/$(database)/documents/personas_cuidadas/$(personaId)).data.miembrosUids;
    }

    function invitacion(codigo) {
      return get(/databases/$(database)/documents/invitaciones/$(codigo)).data;
    }

    // Una invitación se puede canjear si pertenece a esa persona, está activa, no venció y tiene usos
    function invitacionValida(codigo, personaId) {
      return exists(/databases/$(database)/documents/invitaciones/$(codigo))
        && invitacion(codigo).personaId == personaId
        && invitacion(codigo).activa == true
        && invitacion(codigo).expiraEn > request.time
        && invitacion(codigo).usos < invitacion(codigo).usosMax;
    }

    // El documento de miembro que este mismo batch está creando para el usuario actual
    function miMiembroDespues(personaId) {
      return getAfter(/databases/$(database)/documents/personas_cuidadas/$(personaId)/miembros/$(request.auth.uid)).data;
    }

    function canjeValidoDespues(personaId) {
      return miMiembroDespues(personaId).uid == request.auth.uid
        && invitacionValida(miMiembroDespues(personaId).invitacionCodigo, personaId)
        && miMiembroDespues(personaId).rol == rolPorTipo(tipoUsuario(request.auth.uid));
    }

    // La actualización solo agrega mi uid al final de miembrosUids y no toca nada más
    function soloAgregaMiUid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembrosUids'])
        && !(request.auth.uid in resource.data.miembrosUids)
        && request.resource.data.miembrosUids == resource.data.miembrosUids.concat([request.auth.uid]);
    }

    // ---------- validación de datos (mismos límites que el formulario de medicamento) ----------
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Inventario: sin controlar (null) o un entero de 0 en adelante; nunca negativo
    function inventarioValido(d) {
      return !('inventario' in d) || d.inventario == null
        || (d.inventario is int && d.inventario >= 0 && d.inventario <= 9999);
    }

    // Una entrada de bitácora: tipo conocido y texto con algo escrito (la app limita a 2000 caracteres)
    function entradaValida(d) {
      return d.tipo in ['sintoma', 'animo', 'comida', 'sueno', 'incidente', 'nota', 'indicacion']
        && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 2000
        // Solo incidentes: si fue una caída y si hubo lesión
        && (!('caida' in d) || d.caida is bool)
        && (!('lesion' in d) || d.lesion is bool);
    }

    // Las indicaciones médicas son solo del médico, y el médico solo escribe indicaciones
    // (PUEDE_ESCRIBIR_INDICACION en la app)
    function tipoPermitido(personaId, d) {
      return (d.tipo == 'indicacion') == tieneRol(personaId, ['medico']);
    }

    // Una tarea de la rutina: tipo conocido, nombre y hasta 12 horarios
    function tareaValida(d) {
      return d.tipo in ['comida', 'bano', 'ejercicio', 'terapia', 'signos', 'cita', 'otro']
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60
        && d.horarios is list && d.horarios.size() <= 12
        && (!('notas' in d) || (d.notas is string && d.notas.size() <= 300));
    }

    // Un registro de tarea: hecha/no hecha y nota corta
    function registroValido(d) {
      return d.hecha is bool
        && (!('nota' in d) || (d.nota is string && d.nota.size() <= 200));
    }

    // Una cita, terapia o estudio del calendario (o un turno de versiones anteriores): tipo conocido,
    // título, inicio y fin como fechas (termina después de empezar), textos con tope y aviso previo
    // en minutos (hasta una semana antes). Mismos topes que el formulario de la app.
    function eventoValido(d) {
      return d.tipo in ['cita', 'terapia', 'turno']
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 80
        && d.inicio is timestamp && d.fin is timestamp && d.fin >= d.inicio
        && (!('lugar' in d) || (d.lugar is string && d.lugar.size() <= 120))
        && (!('notas' in d) || (d.notas is string && d.notas.size() <= 300))
        && (!('avisarMin' in d) || (d.avisarMin is int && d.avisarMin >= 0 && d.avisarMin <= 10080));
    }

    // Último resurtido (lo que propone el botón Resurtir): opcional; si viene, un entero de 1 a 9999
    function resurtidoValido(d) {
      return !('ultimoResurtido' in d)
        || (d.ultimoResurtido is int && d.ultimoResurtido >= 1 && d.ultimoResurtido <= 9999);
    }

    function medicamentoValido(d) {
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60
        && d.dosis is string && d.dosis.size() > 0 && d.dosis.size() <= 40
        && d.horarios is list && d.horarios.size() <= 12
        && (!('notas' in d) || (d.notas is string && d.notas.size() <= 300))
        && (!('duracionDias' in d) || d.duracionDias == null
            || (d.duracionDias is int && d.duracionDias >= 1 && d.duracionDias <= 365))
        && inventarioValido(d)
        && resurtidoValido(d);
    }

    // Registrar o deshacer una toma mueve el inventario de uno en uno
    // (o deja en 0 un negativo que venga de versiones anteriores de la app)
    function ajusteDeToma() {
      return request.resource.data.inventario == resource.data.inventario - 1
        || request.resource.data.inventario == resource.data.inventario + 1
        || (resource.data.inventario < 0 && request.resource.data.inventario == 0);
    }

    // Una medición: tipo conocido y números con sentido (la presión lleva la diastólica en valorSecundario)
    // Vale con o sin tarea (`tareaId`): también se miden signos sueltos en cualquier momento
    function signoValido(d) {
      return d.tipo in ['presion', 'glucosa', 'temperatura', 'oxigenacion', 'pulso', 'peso']
        && d.valor is number && d.valor > 0 && d.valor <= 1000
        && (!('valorSecundario' in d) || d.valorSecundario == null
            || (d.valorSecundario is number && d.valorSecundario > 0 && d.valorSecundario <= 1000))
        && (!('nota' in d) || (d.nota is string && d.nota.size() <= 200))
        // Solo glucosa: en qué momento se midió (MOMENTOS_GLUCOSA en la app)
        && (!('momento' in d) || d.momento in ['ayunas', 'despues_comer', 'antes_dormir', 'otro']);
    }

    // Preguntas de la familia para el médico: un solo texto compartido, firmado por quien lo guardó
    function preguntasValidas(d) {
      return d.texto is string && d.texto.size() <= 1000
        && d.actualizadoPor == request.auth.uid;
    }

    function tomaValida(d) {
      return d.tomado is bool
        && d.horaProgramada is timestamp
        && (!('nota' in d) || (d.nota is string && d.nota.size() <= 200));
    }

    // Preferencias de avisos de un miembro (las elige cada quien en Notificaciones; mismos valores en la app)
    function preferenciasValidas(d) {
      return (!('avisos' in d) || d.avisos in ['todos', 'importantes', 'ninguno'])
        && (!('recordatorios' in d) || d.recordatorios is bool)
        && (!('soloEnTurno' in d) || d.soloEnTurno is bool);
    }

    // Un medicamento suspendido no admite tomas nuevas (el tratamiento terminado lo frena la app).
    // getAfter: el medicamento puede crearse en el mismo batch que sus tomas (semillas de datos).
    function medicamentoActivo(personaId, medicamentoId) {
      return getAfter(/databases/$(database)/documents/personas_cuidadas/$(personaId)/medicamentos/$(medicamentoId)).data.activo == true;
    }

    // ---------- usuarios/{uid} ----------
    match /usuarios/{userId} {
      allow read: if autenticado();
      // Cada quien crea y edita solo su propio perfil; el tipo de cuenta es obligatorio y,
      // una vez definido, no cambia (las cuentas antiguas sin tipo pueden definirlo una vez)
      allow create: if autenticado() && request.auth.uid == userId
        && request.resource.data.tipo in ['familiar', 'enfermero', 'medico'];
      allow update: if autenticado() && request.auth.uid == userId
        && request.resource.data.tipo in ['familiar', 'enfermero', 'medico']
        && (!('tipo' in resource.data) || request.resource.data.tipo == resource.data.tipo);
      allow delete: if autenticado() && request.auth.uid == userId;
    }

    // ---------- invitaciones/{codigo} ----------
    match /invitaciones/{codigo} {
      // El código (8 caracteres aleatorios) es la llave: se puede leer uno concreto, no listar todos
      allow get: if autenticado();
      allow list: if tieneRol(resource.data.personaId, ['cuidador_principal']);
      allow create: if autenticado()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.personaId is string
        && tieneRol(request.resource.data.personaId, ['cuidador_principal'])
        && request.resource.data.usos == 0
        && request.resource.data.usosMax > 0
        && request.resource.data.expiraEn > request.time;
      allow update: if tieneRol(resource.data.personaId, ['cuidador_principal'])
        // ...o quien la canjea, que solo puede sumar 1 a usos
        || (autenticado()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usos'])
            && request.resource.data.usos == resource.data.usos + 1
            && invitacionValida(codigo, resource.data.personaId));
      allow delete: if tieneRol(resource.data.personaId, ['cuidador_principal']);
    }

    // ---------- personas_cuidadas/{id} ----------
    match /personas_cuidadas/{personaId} {
      // Leer/listar: solo si mi uid está en miembrosUids (hace posible el query array-contains)
      allow read: if autenticado() && request.auth.uid in resource.data.miembrosUids;
      // Crear: solo una cuenta de tipo familiar, y debe quedar como miembro
      allow create: if autenticado()
        && request.auth.uid in request.resource.data.miembrosUids
        && request.resource.data.creadoPor == request.auth.uid
        && tipoUsuario(request.auth.uid) == 'familiar';
      // Actualizar: el responsable, o alguien que se une con una invitación válida
      allow update: if tieneRol(personaId, ['cuidador_principal'])
        || (autenticado() && soloAgregaMiUid() && canjeValidoDespues(personaId));
      allow delete: if tieneRol(personaId, ['cuidador_principal']);

      // miembros/{uid}: quién tiene acceso y con qué rol
      match /miembros/{memberId} {
        allow read: if esMiembro(personaId);
        // Un miembro nuevo puede traer sus avisos por defecto (AVISOS_POR_DEFECTO en la app), válidos
        allow create: if preferenciasValidas(request.resource.data) && (
          // el responsable agrega a alguien con un rol acorde a su tipo de cuenta
          (tieneRol(personaId, ['cuidador_principal'])
            && rolCompatible(tipoUsuario(memberId), request.resource.data.rol))
          || (memberId == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && estaraEnMiembrosUids(personaId)
              && (
                // (a) un familiar crea la persona en este mismo batch y queda como responsable
                (!exists(/databases/$(database)/documents/personas_cuidadas/$(personaId))
                  && request.resource.data.rol == 'cuidador_principal'
                  && tipoUsuario(request.auth.uid) == 'familiar')
                // (b) o canjea una invitación válida con el rol que corresponde a su cuenta
                || (invitacionValida(request.resource.data.invitacionCodigo, personaId)
                    && request.resource.data.rol == rolPorTipo(tipoUsuario(request.auth.uid)))
              )));
        // El responsable cambia roles (p. ej. hacer responsable a otro familiar), siempre acordes al tipo
        allow update: if (tieneRol(personaId, ['cuidador_principal'])
            && request.resource.data.uid == resource.data.uid
            && rolCompatible(tipoUsuario(memberId), request.resource.data.rol))
          // ...o cada quien actualiza solo su propio nombre (al editar su perfil) y sus
          // preferencias de avisos (Notificaciones); los turnos y el rol siguen siendo del responsable
          || (memberId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['nombre', 'avisos', 'recordatorios', 'soloEnTurno'])
            && preferenciasValidas(request.resource.data));
        allow delete: if tieneRol(personaId, ['cuidador_principal']);
      }

      // entradas_bitacora: responsable, enfermeros y familiares registran; el médico solo escribe
      // indicaciones médicas (tipo 'indicacion'), que nadie más escribe ni convierte.
      // El autor edita/borra lo suyo; el responsable, todo (salvo editar una indicación).
      match /entradas_bitacora/{entradaId} {
        allow read: if esMiembro(personaId);
        allow create: if tieneRol(personaId, ['cuidador_principal', 'cuidador_turno', 'familiar', 'medico'])
          && request.resource.data.autorUid == request.auth.uid
          && entradaValida(request.resource.data)
          && tipoPermitido(personaId, request.resource.data);
        // El autor corrige lo suyo (sin cambiar de autor); el responsable, todo
        allow update: if (tieneRol(personaId, ['cuidador_principal'])
            || (esMiembro(personaId) && resource.data.autorUid == request.auth.uid))
          && request.resource.data.autorUid == resource.data.autorUid
          && entradaValida(request.resource.data)
          && tipoPermitido(personaId, request.resource.data);
        allow delete: if tieneRol(personaId, ['cuidador_principal'])
          || (esMiembro(personaId) && resource.data.autorUid == request.auth.uid);
      }

      // consulta/preguntas: las preguntas de la familia para el médico (hoja para la consulta).
      // Las escriben quienes escriben en la bitácora; el médico las lee.
      match /consulta/{docId} {
        allow read: if esMiembro(personaId);
        allow create, update: if docId == 'preguntas'
          && tieneRol(personaId, ['cuidador_principal', 'cuidador_turno', 'familiar'])
          && preguntasValidas(request.resource.data);
        allow delete: if tieneRol(personaId, ['cuidador_principal']);
      }

      // medicamentos: solo el responsable los define (con datos válidos); quienes registran tomas
      // solo ajustan el inventario, de uno en uno, y nunca por debajo de 0.
      // Suspender/reactivar, el ajuste de inventario y el resurtido del responsable (inventario +
      // ultimoResurtido) no revalidan el resto del documento, para no bloquear medicamentos
      // guardados antes de que existieran estos límites.
      match /medicamentos/{medicamentoId} {
        allow read: if esMiembro(personaId);
        allow create: if tieneRol(personaId, ['cuidador_principal'])
          && medicamentoValido(request.resource.data);
        allow delete: if tieneRol(personaId, ['cuidador_principal']);
        allow update: if (tieneRol(personaId, ['cuidador_principal'])
              && (soloCambia(['activo'])
                  || (soloCambia(['inventario', 'ultimoResurtido'])
                      && inventarioValido(request.resource.data)
                      && resurtidoValido(request.resource.data))
                  || medicamentoValido(request.resource.data)))
          || (tieneRol(personaId, ['cuidador_turno', 'familiar'])
              && soloCambia(['inventario'])
              && inventarioValido(request.resource.data)
              && ajusteDeToma());

        // tomas: responsable, enfermeros y familiares registran (y corrigen) las tomas, firmadas
        // por quien escribe; el responsable además puede cambiar solo la nota de cualquier toma.
        match /tomas/{tomaId} {
          allow read: if esMiembro(personaId);
          allow create, update, delete: if tieneRol(personaId, ['cuidador_principal', 'cuidador_turno', 'familiar'])
            && (request.method == 'delete'
                || (tomaValida(request.resource.data)
                    && (request.method == 'update' || medicamentoActivo(personaId, medicamentoId))
                    && (request.resource.data.registradoPor == request.auth.uid
                        || (tieneRol(personaId, ['cuidador_principal'])
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nota'])))));
        }
      }

      // tareas (rutina: comidas, baño, ejercicio…): solo el responsable las define;
      // quienes cuidan registran si se hicieron (firmado por ellos); el médico solo lee.
      match /tareas/{tareaId} {
        allow read: if esMiembro(personaId);
        allow create: if tieneRol(personaId, ['cuidador_principal']) && tareaValida(request.resource.data);
        // Suspender/reactivar no revalida el resto (tareas guardadas antes de estos límites)
        allow update: if tieneRol(personaId, ['cuidador_principal'])
          && (soloCambia(['activo']) || tareaValida(request.resource.data));
        allow delete: if tieneRol(personaId, ['cuidador_principal']);

        match /registros/{registroId} {
          allow read: if esMiembro(personaId);
          allow create, update, delete: if tieneRol(personaId, ['cuidador_principal', 'cuidador_turno', 'familiar'])
            && (request.method == 'delete'
                || (registroValido(request.resource.data)
                    && (request.resource.data.registradoPor == request.auth.uid
                        || (tieneRol(personaId, ['cuidador_principal'])
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nota'])))));
        }
      }

      // recordatorios/{id}: qué dosis, tareas y avisos previos ya se enviaron. Solo lo escriben las Cloud Functions
      // (Admin SDK, no pasa por estas reglas); desde la app no hay acceso (denegado por defecto).

      // eventos_calendario: citas, terapias y estudios de una sola vez. Los agendan, editan y borran
      // el responsable y los familiares (PUEDE_EDITAR_CITAS en la app); enfermeros y médicos los ven.
      match /eventos_calendario/{eventoId} {
        allow read: if esMiembro(personaId);
        allow create, update: if tieneRol(personaId, ['cuidador_principal', 'familiar'])
          && eventoValido(request.resource.data);
        allow delete: if tieneRol(personaId, ['cuidador_principal', 'familiar']);
      }

      // signos_vitales: los registran (firmados) quienes marcan tareas de la rutina, porque se
      // capturan al marcar como hecha una tarea de signos vitales; corregir el registro reescribe o
      // borra sus mediciones. El médico solo lee. Tipos y límites: los de TIPOS_SIGNO en la app.
      match /signos_vitales/{signoId} {
        allow read: if esMiembro(personaId);
        allow create, update: if tieneRol(personaId, ['cuidador_principal', 'cuidador_turno', 'familiar'])
          && request.resource.data.autorUid == request.auth.uid
          && signoValido(request.resource.data);
        allow delete: if tieneRol(personaId, ['cuidador_principal', 'cuidador_turno', 'familiar']);
      }
    }
  }
}
